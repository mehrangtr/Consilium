{
  "schema_version": 1,
  "notice": "No product phase can close until actual phase checks, exit evidence and review are registered.",
  "phases": {
    "P00": [
      {
        "id": "scope_inventory",
        "kind": "static",
        "argv": [
          "{python}",
          "tools/check_scope.py"
        ],
        "scope": "P00_SCOPE_NOT_PRODUCT_RUNTIME"
      },
      {
        "id": "development_regression",
        "kind": "test",
        "argv": [
          "{python}",
          "tools/check.py"
        ],
        "junit": "evidence/control-tests/JUNIT.xml",
        "scope": "CONTROL_TESTS_NOT_RUNTIME_CONFORMANCE"
      }
    ],
    "P01": [
      {
        "id": "foundation_behavior",
        "kind": "test",
        "argv": [
          "{python}",
          "tools/run_foundation_tests.py"
        ],
        "junit": "evidence/foundation-tests/JUNIT.xml",
        "scope": "APPLICATION_FOUNDATION_NOT_FULL_RUNTIME_CONFORMANCE"
      },
      {
        "id": "environment_lock",
        "kind": "static",
        "argv": [
          "{python}",
          "tools/check_environment.py"
        ]
      },
      {
        "id": "native_target_matrix",
        "kind": "static",
        "argv": [
          "{python}",
          "tools/check_target_matrix.py"
        ],
        "scope": "BOTH_SELECTED_TARGETS_REQUIRED; NO_MOCK_SUBSTITUTION"
      }
    ],
    "P02": [
      {
        "id": "persistence_durable_kernel",
        "kind": "test",
        "argv": [
          "{python}",
          "tools/run_persistence_tests.py"
        ],
        "junit": "evidence/persistence-tests/JUNIT.xml",
        "scope": "P02_DURABLE_KERNEL_BEHAVIOR_NOT_FULL_V1_CONFORMANCE"
      }
    ],
    "P03": [
      {
        "id": "browser_probe_preflight_and_durability",
        "kind": "test",
        "argv": [
          "{python}",
          "tools/run_browser_probe_tests.py"
        ],
        "junit": "evidence/browser-probe-tests/JUNIT.xml",
        "scope": "P03_OFFLINE_SAFETY_TESTS; NOT_LIVE_PROVIDER_CERTIFICATION"
      },
      {
        "id": "p03_live_evidence_consistency",
        "kind": "static",
        "argv": [
          "{python}",
          "tools/check_p03_feasibility.py"
        ],
        "scope": "ACTUAL_LIVE_BROWSER_EVIDENCE_ACCEPTANCE_CHECK; COMMAND_VALIDATES_RECORDS_ONLY; NO_NEW_UI_ACTION",
        "execution_mode": "LIVE_BROWSER",
        "acceptance_only": true,
        "reason": "Acceptance of already executed actual Claude UI probes and controlled sign-out. This static command validates captured live findings and hashes; it makes no browser call and does not independently authenticate observations. Separate manual review of original evidence is mandatory. Exclude it from future regression runs to prevent replaying live sends or relabeling old snapshots as current."
      }
    ],
    "P04": [
      {
        "id": "architect_and_independent_context",
        "kind": "test",
        "argv": [
          "{python}",
          "tools/run_architect_tests.py"
        ],
        "junit": "evidence/architect-tests/JUNIT.xml",
        "scope": "P04_FULL_OFFLINE_QUESTION_AUTHORIZED_CONTEXT_CONTRACTS; LIVE_ADAPTER_CERTIFICATION_REMAINS_P08_P09"
      },
      {
        "id": "p04_executed_context_exit_examples",
        "kind": "static",
        "argv": [
          "{python}",
          "tools/record_p04_context_examples.py"
        ],
        "scope": "EXECUTED_OFFLINE_CONTEXT_EXIT_EXAMPLES_NOT_LIVE_PROVIDER_CERTIFICATION"
      }
    ],
    "P05": [],
    "P06": [],
    "P07": [],
    "P08": [],
    "P09": [],
    "P10": [],
    "P11": [],
    "P12": [],
    "P13": [],
    "P14": [],
    "P15": [],
    "P16": []
  },
  "maintenance": [
    {
      "id": "portable_development_check",
      "kind": "test",
      "argv": [
        "{python}",
        "tools/check.py"
      ],
      "junit": "evidence/control-tests/JUNIT.xml",
      "scope": "DEVELOPMENT_CONTROL_TOOLING_ONLY"
    }
  ]
}
